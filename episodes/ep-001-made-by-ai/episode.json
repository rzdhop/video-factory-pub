 "words": [
  {
   "text": "Can an AI",
   "t_start": 0.0,
   "t_end": 0.59,
   "accent": null,
   "chapter": "hook"
  },
  {
   "text": "make this video",
   "t_start": 0.59,
   "t_end": 1.4,
   "accent": null,
   "chapter": "hook"
  },
  {
   "text": "by itself?",
   "t_start": 1.4,
   "t_end": 1.82,
   "accent": "itself",
   "chapter": "hook"
  },
  {
   "text": "Almost.",
   "t_start": 2.39,
   "t_end": 2.9,
   "accent": "Almost",
   "chapter": "hook"
  },
  {
   "text": "It had to ask",
   "t_start": 3.12,
   "t_end": 3.71,
   "accent": null,
   "chapter": "hook"
  },
  {
   "text": "a person",
   "t_start": 3.71,
   "t_end": 4.18,
   "accent": null,
   "chapter": "hook"
  },
  {
   "text": "three times.",
   "t_start": 4.18,
   "t_end": 4.91,
   "accent": "three",
   "chapter": "hook"
  },
  {
   "text": "It pitched three ideas;",
   "t_start": 5.14,
   "t_end": 6.26,
   "accent": "ideas",
   "chapter": "line"
  },
  {
   "text": "a person picked one.",
   "t_start": 6.26,
   "t_end": 7.27,
   "accent": "picked",
   "chapter": "line"
  },
  {
   "text": "It wrote the script,",
   "t_start": 7.49,
   "t_end": 8.46,
   "accent": null,
   "chapter": "line"
  },
  {
   "text": "and a second agent",
   "t_start": 8.46,
   "t_end": 9.23,
   "accent": "agent",
   "chapter": "line"
  },
  {
   "text": "checked every fact.",
   "t_start": 9.23,
   "t_end": 10.26,
   "accent": "fact",
   "chapter": "line"
  },
  {
   "text": "It asked again",
   "t_start": 10.48,
   "t_end": 11.09,
   "accent": null,
   "chapter": "line"
  },
  {
   "text": "before paying",
   "t_start": 11.09,
   "t_end": 11.6,
   "accent": null,
   "chapter": "line"
  },
  {
   "text": "for the voice.",
   "t_start": 11.6,
   "t_end": 12.26,
   "accent": "voice",
   "chapter": "line"
  },
  {
   "text": "It drew every scene",
   "t_start": 12.48,
   "t_end": 13.4,
   "accent": null,
   "chapter": "line"
  },
  {
   "text": "in code.",
   "t_start": 13.4,
   "t_end": 13.78,
   "accent": "code",
   "chapter": "line"
  },
  {
   "text": "It can't hear,",
   "t_start": 13.94,
   "t_end": 14.56,
   "accent": "hear",
   "chapter": "line"
  },
  {
   "text": "so it picks sounds",
   "t_start": 14.56,
   "t_end": 15.41,
   "accent": null,
   "chapter": "line"
  },
  {
   "text": "by their score.",
   "t_start": 15.41,
   "t_end": 16.06,
   "accent": "score",
   "chapter": "line"
  },
  {
   "text": "Then it renders,",
   "t_start": 16.61,
   "t_end": 17.56,
   "accent": null,
   "chapter": "human"
  },
  {
   "text": "and stops.",
   "t_start": 17.96,
   "t_end": 18.53,
   "accent": "stops",
   "chapter": "human"
  },
  {
   "text": "Last question:",
   "t_start": 18.75,
   "t_end": 19.51,
   "accent": null,
   "chapter": "human"
  },
  {
   "text": "may I post it?",
   "t_start": 19.81,
   "t_end": 20.63,
   "accent": "post",
   "chapter": "human"
  },
  {
   "text": "The engine",
   "t_start": 20.75,
   "t_end": 21.29,
   "accent": null,
   "chapter": "question"
  },
  {
   "text": "and its rulebook",
   "t_start": 21.29,
   "t_end": 22.04,
   "accent": "rulebook",
   "chapter": "question"
  },
  {
   "text": "are open source:",
   "t_start": 22.04,
   "t_end": 22.95,
   "accent": "source",
   "chapter": "question"
  },
  {
   "text": "your AI",
   "t_start": 22.95,
   "t_end": 23.6,
   "accent": null,
   "chapter": "question"
  },
  {
   "text": "can make yours.",
   "t_start": 23.6,
   "t_end": 24.3,
   "accent": "yours",
   "chapter": "question"
  },
  {
   "text": "Would you give an AI",
   "t_start": 24.77,
   "t_end": 25.72,
   "accent": "you",
   "chapter": "question"
  },
  {
   "text": "the director's chair?",
   "t_start": 25.72,
   "t_end": 26.49,
   "accent": "chair",
   "chapter": "question"
  },
  {
   "text": "The code's on GitHub,",
   "t_start": 26.65,
   "t_end": 27.66,
   "accent": "GitHub",
   "chapter": "question"
  },
  {
   "text": "link in the bio.",
   "t_start": 27.66,
   "t_end": 28.51,
   "accent": null,
   "chapter": "question"
  }
 ],
